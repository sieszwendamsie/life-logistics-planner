<style>
/* Layout: one column; a wall-planner strip of 12 months up top, then the decisions as tables. */
:root {
  --bg: #f6f7f4; --surface: #ffffff; --ink: #1d2320; --muted: #5b645f; --line: #dde1dc;
  --home: #dfe5ea; --home-we: #b9c3cc; --we-ring: #d23b3b; --stay: #3f8f6b; --solo: #a9d6bf; --solo-stripe: #8cc4a8; --band: #f1f3ef; --sb: #3f8f6b; --trip: #e7c66b; --holiday: #7a6fc4; --shut: #9aa19c;
  --it: #c0392b; --pl: #2f5fa7; --on-solo: #1d2320; --accent: #2d6a4f; --pick: rgba(63, 143, 107, 0.12);
  --font-head: "Space Grotesk", system-ui, sans-serif;
  --font-body: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #141816; --surface: #1c211f; --ink: #e6e9e6; --muted: #a0a9a4; --line: #313834;
    --home: #2c3540; --home-we: #46525f; --we-ring: #f06a6a; --stay: #4fa881; --solo: #2f5f4a; --solo-stripe: #3a6f57; --band: #232926; --sb: #6fd3a6; --trip: #8a7232; --holiday: #988de0; --shut: #5f6762;
    --it: #ec7a6c; --pl: #7ea6e6; --accent: #7cc5a1; --pick: rgba(79, 168, 129, 0.16);
    --on-solo: #e6e9e6;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #141816; --surface: #1c211f; --ink: #e6e9e6; --muted: #a0a9a4; --line: #313834;
  --home: #2c3540; --home-we: #46525f; --we-ring: #f06a6a; --stay: #4fa881; --solo: #2f5f4a; --solo-stripe: #3a6f57; --band: #232926; --sb: #6fd3a6; --trip: #8a7232; --holiday: #988de0; --shut: #5f6762;
  --it: #ec7a6c; --pl: #7ea6e6; --accent: #7cc5a1; --pick: rgba(79, 168, 129, 0.16);
  --on-solo: #e6e9e6;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body { background: var(--bg); color: var(--ink); font: 15px/1.55 var(--font-body); }
main {
  max-width: 1060px; margin: 0 auto; padding-block: 28px 56px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  display: grid; gap: 28px;
}
h1, h2 { font-family: var(--font-head); text-wrap: balance; margin: 0; }
h1 { font-size: 1.9rem; line-height: 1.15; }
h2 { font-size: 1.25rem; }
p { margin: 0; max-width: 68ch; }
.sub { color: var(--muted); }
section { display: grid; gap: 12px; min-width: 0; }
.totals { display: flex; flex-wrap: wrap; gap: 8px 28px; }
.totals div { display: grid; }
.totals b { font-family: var(--font-head); font-size: 1.5rem; font-variant-numeric: tabular-nums; }
.totals span { color: var(--muted); font-size: 0.85rem; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 0.85rem; color: var(--muted); }
.legend span::before {
  content: ""; display: inline-block; width: 12px; height: 12px; border-radius: 3px;
  margin-right: 6px; vertical-align: -2px; background: var(--c);
}
.legend .ring::before { background: transparent; box-shadow: inset 0 0 0 2px var(--c); }
.legend .dot::before { width: 6px; height: 6px; border-radius: 50%; vertical-align: 1px; }
.cal { display: grid; gap: 10px; min-width: 0; }
.view { display: flex; flex-wrap: wrap; gap: 6px; font-size: 0.85rem; }
.view label { border: 1px solid var(--line); border-radius: 999px; padding: 2px 12px; background: var(--surface); cursor: pointer; }
.view label:has(input:checked) { background: var(--accent); border-color: var(--accent); color: var(--surface); font-weight: 600; }
.view label:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
.view input { position: absolute; opacity: 0; pointer-events: none; }
.wall { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 8px; }
.wall.week { display: none; }
.cal:has(input[value="week"]:checked) .wall.date { display: none; }
.cal:has(input[value="week"]:checked) .wall.week { display: block; }
/* Each month is its own band, with space between, so rows don't run together. */
.month { display: grid; grid-template-columns: 40px repeat(31, 24px); gap: 2px; align-items: center; width: max-content; padding: 4px 6px; border-radius: 6px; }
.wall.week .month { grid-template-columns: 40px repeat(37, 22px); }
.month:nth-child(odd) { background: var(--band); }
.month + .month { margin-top: 4px; }
.month.head { background: none; padding-block: 0; }
.wd { font-size: 0.66rem; font-weight: 600; color: var(--muted); text-align: center; }
.wd.we { color: var(--we-ring); }
.month .m { font-size: 0.8rem; font-weight: 600; color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; }
.d {
  position: relative; height: 24px; border-radius: 3px; font-size: 0.66rem; line-height: 24px;
  text-align: center; font-variant-numeric: tabular-nums; color: var(--ink);
}
.d.we { font-weight: 700; }
/* Weekends: red ring everywhere, and a darker shade of whatever colour the day has. */
.d.we:not(.home) { filter: brightness(0.84) saturate(1.15); }
.home.we { background-color: var(--home-we); }
.d.we::after {
  content: ""; position: absolute; left: 3px; right: 3px; bottom: 2px; height: 2px;
  border-radius: 1px; background: currentColor; opacity: 0.55;
}
.d.off { box-shadow: inset 0 0 0 2px var(--holiday); }
.d.we { box-shadow: inset 0 0 0 2px var(--we-ring); }
.d.we.off { box-shadow: inset 0 0 0 2px var(--we-ring), inset 0 0 0 4px var(--holiday); }
.home { background: var(--home); }
.trip { background: var(--trip); color: var(--ink); }
.stay { background: var(--stay); color: var(--surface); }
.solo { background: repeating-linear-gradient(135deg, var(--solo) 0 4px, var(--solo-stripe) 4px 8px); color: var(--on-solo); }
.d.sb { background-image: linear-gradient(135deg, transparent 62%, var(--sb) 62%); }
.legend .sb-key::before { background: linear-gradient(135deg, var(--home) 50%, var(--sb) 50%); }
.legend .solo-key::before { background: repeating-linear-gradient(135deg, var(--solo) 0 3px, var(--solo-stripe) 3px 6px); }
.holiday { background: var(--holiday); color: var(--surface); }
.d i { position: absolute; top: 2px; width: 5px; height: 5px; border-radius: 50%; }
.d i.it { right: 2px; background: var(--it); }
.d i.pl { left: 2px; background: var(--pl); }
.d b.ev, .evk { position: absolute; bottom: 1px; right: 2px; font-size: 9px; line-height: 1; font-weight: 800; padding: 1px 2px; border-radius: 3px; background: var(--surface); color: var(--ink); }
.evk { position: static; border: 1px solid var(--line); }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 16px; display: grid; gap: 10px; align-content: start; min-width: 0; }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { color: var(--muted); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
td.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
tr.pick td { background: var(--pick); }
.pill { display: inline-block; font-size: 0.72rem; font-weight: 600; padding: 1px 8px; border-radius: 999px; background: var(--accent); color: var(--surface); }
.note { color: var(--muted); font-size: 0.85rem; }
ul { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
.grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
</style>
